/*
@author Liquibase
@version 1.1
@date 13-Oct-2026
@description Error script contains DML on a table listed in the ijet_restricted_tables.txt file.

Version 1.1:
- Reports WHERE the problem is: for each restricted table that has DML against
  it, prints (console + deployPackager log, so it also lands in daticaldb.log)
  the starting text of the offending statement, and adds the table name and the
  line number(s) from woc.getLineNumbers() to the Response message. Statement
  text is used in addition to line numbers because WithoutComments() strips
  comments before this text arrives, so line counts calculated here would not
  match the file; the framework's getLineNumbers() is used instead.
- Strips quoted string literal contents (Oracle-style, dynamic-SQL aware) before
  scanning, so text values such as 'please delete from owner.tbl now' are not
  mistaken for DML. DML inside EXECUTE IMMEDIATE is still found.
- The table name no longer has to be followed by whitespace. Before, these were
  NOT detected: "delete from owner.tbl;" and "insert into owner.tbl(col) ...".
  A longer name such as owner.tbl_archive is still not matched by owner.tbl.
- Lines in the restricted tables file are trimmed, and the file is now always
  closed (it was left open when a restricted table was found).
- The text is no longer lowercased in the "when" clause (the regex is already
  CASE_INSENSITIVE), so the printed statement text matches the original file.
*/

package com.datical.hammer.core.sqlrules.RestrictDMLonTables

import java.io.File;
import java.io.FileNotFoundException;
import java.util.*;
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import com.datical.hammer.core.rules.WithoutComments;
import com.datical.hammer.core.rules.Response;
import com.datical.hammer.core.rules.Response.ResponseType;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;


/*
 * Strips single-quoted SQL string literal contents so they are not scanned
 * as SQL. Handles Oracle-style doubled single quotes ('') as escaped quotes,
 * and is aware of EXECUTE IMMEDIATE dynamic SQL, where the real SQL command
 * is itself built as a string literal via concatenation.
 *
 * Known limitation: only triggers off the literal keyword "EXECUTE IMMEDIATE"
 * appearing before the string. Dynamic SQL built into a variable earlier and
 * executed later (v_sql := '...'; ... EXECUTE IMMEDIATE v_sql;) won't be
 * recognized as code, and the literal will be treated as an ordinary value
 * (fully masked). Also does not handle alternative Oracle quoting (q'[...]').
 */
function String stripStringLiterals(String sql) {
	StringBuilder out = new StringBuilder(sql.length());
	int n = sql.length();
	int i = 0;
	boolean inDynamicSqlChain = false;
	boolean dataMode = true;
	String upper = sql.toUpperCase();
	String KEYWORD = "EXECUTE IMMEDIATE";
	int keywordLen = KEYWORD.length();

	while (i < n) {
		String c = sql.substring(i, i + 1);

		if (c.equals("'")) {
			if (!inDynamicSqlChain) {
				dataMode = true;
			}
			out.append("'");
			i = i + 1;
			while (i < n) {
				String lc = sql.substring(i, i + 1);
				if (lc.equals("'")) {
					if (i + 1 < n && sql.substring(i + 1, i + 2).equals("'")) {
						dataMode = !dataMode;
						out.append("''");
						i = i + 2;
						continue;
					} else {
						out.append("'");
						i = i + 1;
						break;
					}
				} else {
					if (dataMode) {
						// preserve whitespace so masked data doesn't collapse into one
						// long non-whitespace run, which slows regex matching below
						if (lc.equals(" ") || lc.equals("\t") || lc.equals("\n") || lc.equals("\r")) {
							out.append(lc);
						} else {
							out.append("x");
						}
					} else {
						out.append(lc);
					}
					i = i + 1;
				}
			}
			continue;
		}

		if (!inDynamicSqlChain && i + keywordLen <= n
				&& upper.regionMatches(i, KEYWORD, 0, keywordLen)) {
			inDynamicSqlChain = true;
			dataMode = false;
			out.append(sql.substring(i, i + keywordLen));
			i = i + keywordLen;
			continue;
		}

		if (inDynamicSqlChain && c.equals(";")) {
			inDynamicSqlChain = false;
		}

		out.append(c);
		i = i + 1;
	}

	return out.toString();
}

/*
 * Reads the restricted tables from the external text file. Each non-empty line
 * is used as a regular expression fragment for the table name (for example
 * owner\.table_name). If the file cannot be read, an error is printed and the
 * list is empty (so nothing is flagged), as before.
 */
function List<String> loadRestrictedTables() {
	//Name of the file with the restricted tables
	String stopStatementFilename = "ijet_restricted_tables.txt";
	String pathToFile = System.getProperty("user.dir") + "/Rules/SqlRules/" + stopStatementFilename;

	List<String> tables = new ArrayList<String>();
	Scanner statementsScan = null;
	try {
		statementsScan = new Scanner(new File(pathToFile));
		while (statementsScan.hasNextLine()) {
			String line = statementsScan.nextLine().trim();
			if (line.length() > 0) {
				tables.add(line);
			}
		}
	} catch (FileNotFoundException e) {
		System.out.println("An error occurred reading the forbidden tables file: " + stopStatementFilename);
		e.printStackTrace();
	} finally {
		if (statementsScan != null) {
			statementsScan.close();
		}
	}
	return tables;
}

/*
 * Strips string literals, then replaces various line ending styles and white
 * spaces with a single space, then removes multiple spaces.
 */
function String prepareSql(String sql) {
	return stripStringLiterals(sql)
			.replaceAll("\\r\\n|\\r|\\n", " ")
			.replaceAll("\t", " ")
			.replaceAll("\\s+", " ")
			.trim();
}

/*
 * INSERT INTO / DELETE FROM / UPDATE followed by the restricted table. The
 * table name must not be followed by more of a name (letter, digit, _ $ # or
 * a dot), so owner.tbl does not match owner.tbl_archive, but it does match
 * when followed by whitespace, ";" or "(". Group 1 is the DML prefix.
 */
function Pattern restrictedPattern(String table) {
	return Pattern.compile("((?:insert\\s+into\\s+)|(?:delete\\s+from\\s+)|(?:update\\s+))(?:" + table + ")(?![\\w$#.])",
			Pattern.MULTILINE | Pattern.CASE_INSENSITIVE);
}

/* @return false if validation fails; true otherwise */
function boolean forbiddenTablessExist(String sql) {
    System.out.println("Validation called: RestrictDMLonTables"); 

	String text = prepareSql(sql);

	//If there is no content to be checked, return true
	if (text.length() == 0) return true;

	for (String table : loadRestrictedTables()) {
		final Matcher matcher = restrictedPattern(table).matcher(text);
		if (matcher.find()) {
			/* System.out.println("DML is not allowed on " + table); */
			return false;
		}
	}
	return true;
}

/*
 * Asks the framework for the line number(s) of the given text. Returns an empty
 * string if it reports none. Uses the table name exactly as it was spelled in
 * the script (the original text, not a regex).
 */
function String restrictedTableLines(WithoutComments woc, String tableToken) {
	try {
		Object lines = woc.getLineNumbers(tableToken);
		String text = ("" + lines).trim();
		if (text.length() > 0 && !text.equals("[]") && !text.equals("null")) {
			return text;
		}
	} catch (Exception e) {
		; // do nothing
	}
	return "";
}

/*
 * Diagnostic only -- does not affect the FAIL/no-FAIL decision, which comes
 * from forbiddenTablessExist above. For every restricted table with DML
 * against it, prints (to both console and the deployPackager logger, so it
 * also lands in daticaldb.log) the START OF EACH OFFENDING STATEMENT. Data
 * values inside quotes are masked (shown as x's) so customer data is not
 * written to the console or log.
 *
 * Returns the text for the Response message: each restricted table found, with
 * the line number(s) the framework reports for that table's name. Note those
 * line numbers are where the table NAME appears, which can include lines that
 * only SELECT from it; the printed statements show the actual DML.
 */
function String reportRestrictedDml(WithoutComments woc) {
	String fileName = woc.getSqlFile().toString();
	String text = prepareSql(woc.getText());
	int maxSnippetLen = 80;
	Logger log = LoggerFactory.getLogger("deployPackager");

	Set<String> details = new LinkedHashSet<String>();

	for (String table : loadRestrictedTables()) {
		String tableDisplay = table.replace("\\", "");
		final Matcher matcher = restrictedPattern(table).matcher(text);
		int lastReportedStart = -1;
		boolean tableDetailAdded = false;

		while (matcher.find()) {
			int stmtStart = text.lastIndexOf(";", matcher.start());
			stmtStart = (stmtStart == -1) ? 0 : stmtStart + 1;
			int stmtEnd = text.indexOf(";", matcher.end());
			stmtEnd = (stmtEnd == -1) ? text.length() : stmtEnd;

			if (stmtStart != lastReportedStart) {
				String snippet = text.substring(stmtStart, stmtEnd).trim().replaceAll("^/\\s*", "");
				if (snippet.length() > maxSnippetLen) {
					snippet = snippet.substring(0, maxSnippetLen) + "...";
				}
				String diagnosticMessage = "RestrictDMLonTables: DML on restricted table \"" + tableDisplay
						+ "\" in statement starting with: \"" + snippet + "\" in file " + fileName;
				System.out.println(diagnosticMessage);
				log.info(diagnosticMessage);
				lastReportedStart = stmtStart;
			}

			if (!tableDetailAdded) {
				// the table name as spelled in the script = the matched text minus the DML prefix
				String tableToken = matcher.group(0).substring(matcher.group(1).length());
				String lines = restrictedTableLines(woc, tableToken);
				if (lines.length() > 0) {
					details.add(tableDisplay + " (table name found on line(s): " + lines + ")");
				} else {
					details.add(tableDisplay);
				}
				tableDetailAdded = true;
			}
		}
	}

	StringBuilder detail = new StringBuilder();
	for (String d : details) {
		if (detail.length() > 0) {
			detail.append("; ");
		}
		detail.append(d);
	}
	return detail.toString();
}

rule "RestrictDMLonTables"
when
		woc : WithoutComments(!forbiddenTablessExist(getText()))
then
		String detail = reportRestrictedDml(woc);
		String errorMessage = "Script contains DML on a restricted table: " + detail + ". (Script: " + woc.getSqlFile().toString() + ")";
		insert(new Response(ResponseType.FAIL, errorMessage, drools.getRule().getName()));
end
