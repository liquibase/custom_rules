/*
@author Liquibase
@version 1.2
@date 20-Oct-2026
@description Warn if CTAS statement does not contain a WHERE clause.
*/
/*
README: 
This is a SQL Rule which throws a WARNING when a sql script has a CTAS statement without a WHERE clause.
To Execute this rule use:
hammer runRules [SQL file | SQL files folder]

Version 1.1: strips quoted string literal contents (Oracle-style, dynamic-SQL
aware) before scanning, so text field values (e.g. a description column
containing words like "create"/"table"/"select"/"where") aren't mistaken
for SQL. Same helper used in the CheckProjectSchemas rule.

Version 1.2: 
Fixes an issue with escaped quotes.

*/
package com.datical.hammer.core.sqlrules.CTASmustHavePredicate
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import com.datical.db.project.Project;
import com.datical.hammer.core.rules.Response;
import com.datical.hammer.core.rules.Response.ResponseType;
import com.datical.hammer.core.rules.WithComments;
import com.datical.hammer.core.rules.WithoutComments;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
/***********************************************************  Rules  *************************************************************/

/*
 * Strips single-quoted SQL string literal contents so they are not scanned
 * as SQL. Handles Oracle-style doubled single quotes ('') as escaped quotes,
 * and is aware of EXECUTE IMMEDIATE dynamic SQL, where the real SQL command
 * is itself built as a string literal via concatenation, e.g.:
 *   EXECUTE IMMEDIATE
 *     'CREATE TABLE ' || tbl_name || ' AS SELECT ' || cols || ' FROM ' || src;
 *
 * Known limitation: only triggers off the literal keyword "EXECUTE IMMEDIATE"
 * appearing before the string. Dynamic SQL built into a variable earlier and
 * executed later (v_sql := '...'; ... EXECUTE IMMEDIATE v_sql;) won't be
 * recognized as code, and the literal will be treated as an ordinary value
 * (fully masked). Also does not handle alternative Oracle quoting (q'[...]').
 */
function String stripStringLiterals(String sql) {
	StringBuilder out = new StringBuilder(sql.length());
	int n = sql.length();
	int i = 0;
	boolean inDynamicSqlChain = false;
	boolean dataMode = true;
	Matcher executeImmediate = Pattern.compile("EXECUTE\\s+IMMEDIATE", Pattern.CASE_INSENSITIVE).matcher(sql);
	// SQL*Plus REM / PROMPT lines are not SQL; an apostrophe in them (PROMPT Don't run twice) is not a quote
	Matcher remarkLine = Pattern.compile("[ \\t]*(REM|REMARK|PRO|PROMPT)\\b", Pattern.CASE_INSENSITIVE).matcher(sql);

	while (i < n) {
		String c = sql.substring(i, i + 1);

		if (!inDynamicSqlChain && (i == 0 || sql.substring(i - 1, i).equals("\n")) && remarkLine.region(i, n).lookingAt()) {
			int lineEnd = sql.indexOf("\n", i);
			lineEnd = (lineEnd == -1) ? n : lineEnd;
			out.append(sql.substring(i, lineEnd));
			i = lineEnd;
			continue;
		}

		if (c.equals("'")) {
			if (!inDynamicSqlChain) {
				dataMode = true;
			}
			out.append("'");
			i = i + 1;
			int valueStart = i;
			int outValueStart = out.length();
			boolean closed = false;
			while (i < n) {
				String lc = sql.substring(i, i + 1);
				if (lc.equals("'")) {
					if (i + 1 < n && sql.substring(i + 1, i + 2).equals("'")) {
						// outside EXECUTE IMMEDIATE a doubled quote is just an escaped quote
						if (inDynamicSqlChain) {
							dataMode = !dataMode;
						}
						out.append("''");
						i = i + 2;
						continue;
					} else {
						out.append("'");
						i = i + 1;
						closed = true;
						break;
					}
				} else {
					if (dataMode) {
						// preserve whitespace so masked data doesn't collapse into one
						// long non-whitespace run, which slows regex matching below
						if (lc.equals(" ") || lc.equals("\t") || lc.equals("\n") || lc.equals("\r")) {
							out.append(lc);
						} else {
							out.append("x");
						}
					} else {
						out.append(lc);
					}
					i = i + 1;
				}
			}
			if (!closed) {
				// never closed: not a value, keep the rest of the script as it is
				out.setLength(outValueStart);
				out.append(sql.substring(valueStart));
				i = n;
			}
			continue;
		}

		if (!inDynamicSqlChain && executeImmediate.region(i, n).lookingAt()) {
			inDynamicSqlChain = true;
			dataMode = false;
			out.append(sql.substring(i, executeImmediate.end()));
			i = executeImmediate.end();
			continue;
		}

		if (inDynamicSqlChain && c.equals(";")) {
			inDynamicSqlChain = false;
		}

		out.append(c);
		i = i + 1;
	}

	return out.toString();
}

/*
 * Diagnostic only -- does not affect the WARN/no-WARN decision, which comes
 * from CTAS_found / CTAS_without_WHERE above. This function prints the
 * START OF THE STATEMENT TEXT (not a line number) for each CTAS statement
 * that is missing a WHERE clause, so the console log can be used to
 * search/locate the specific statement(s).
 *
 * Line numbers are NOT used here because WithoutComments() has already
 * stripped comment text out of the SQL before it reaches this function.
 *
 * Uses the same statement-scoped splitting as CTAS_found / CTAS_without_WHERE
 * above, so its output is consistent with why the rule did or didn't fire.
 */
function void reportCTASWithoutWhereLocations(String sql, String fileName) {
	String sqlToScan = stripStringLiterals(sql);
	int n = sqlToScan.length();

	final Pattern ctasPattern = Pattern.compile("(create)(.+)(table)(.+)(as)(.+)(select)", Pattern.DOTALL | Pattern.CASE_INSENSITIVE);
	final Pattern wherePattern = Pattern.compile("(create)(.+)(table)(.+)(as)(.+)(select)(.+)(where)", Pattern.DOTALL | Pattern.CASE_INSENSITIVE);

	int stmtStart = 0;
	int maxSnippetLen = 80;

	while (stmtStart <= n) {
		int semiIdx = sqlToScan.indexOf(";", stmtStart);
		int stmtEnd = (semiIdx == -1) ? n : semiIdx;

		if (stmtEnd > stmtStart) {
			String statement = sqlToScan.substring(stmtStart, stmtEnd);
			Matcher ctasMatcher = ctasPattern.matcher(statement);
			if (ctasMatcher.find()) {
				Matcher whereMatcher = wherePattern.matcher(statement);
				if (!whereMatcher.find()) {
					String snippet = statement.trim().replaceAll("\\s+", " ");
					if (snippet.length() > maxSnippetLen) {
						snippet = snippet.substring(0, maxSnippetLen) + "...";
					}
					Logger log = LoggerFactory.getLogger("deployPackager");
					String diagnosticMessage = "CTASmustHavePredicate: possible CTAS without WHERE clause starting with: \""
							+ snippet + "\" in file " + fileName;
					System.out.println(diagnosticMessage);
					log.info(diagnosticMessage);
				}
			}
		}

		if (semiIdx == -1) {
			break;
		}
		stmtStart = stmtEnd + 1;
	}
}

/*
 * @return true if a CTAS statement is found ANYWHERE in the file.
 *
 * Statement-scoped: splits on top-level ';' 
 */
function boolean CTAS_found(String sql) {
    System.out.println("Validation called: CTASMustHavePredicate"); 

	String sqlToScan = stripStringLiterals(sql);
	final Pattern pattern = Pattern.compile("(create)(.+)(table)(.+)(as)(.+)(select)", Pattern.DOTALL | Pattern.CASE_INSENSITIVE);

	int n = sqlToScan.length();
	int stmtStart = 0;
	while (stmtStart <= n) {
		int semiIdx = sqlToScan.indexOf(";", stmtStart);
		int stmtEnd = (semiIdx == -1) ? n : semiIdx;
		if (stmtEnd > stmtStart) {
			String statement = sqlToScan.substring(stmtStart, stmtEnd);
			Matcher matcher = pattern.matcher(statement);
			if (matcher.find()) {
				return true;
			}
		}
		if (semiIdx == -1) {
			break;
		}
		stmtStart = stmtEnd + 1;
	}
	return false;
} 

/*
 * @return true if AT LEAST ONE CTAS statement in the file is missing a
 * WHERE clause.
 *
 * Statement-scoped for the same reason as CTAS_found above. Previously this
 * ran a single whole-file regex, which meant that as soon as ANY CTAS
 * statement in the file had a WHERE clause, the greedy DOTALL match could
 * lock onto that statement's keywords and satisfy the pattern -- silently
 * clearing the warning even when an EARLIER, unrelated CTAS statement in
 * the same file genuinely had no WHERE clause. Example that reproduced this:
 *
 *   CREATE TABLE new_customers AS SELECT * FROM customers;
 *   CREATE TABLE new_customers AS SELECT * FROM customers WHERE active = 1;
 */
function boolean CTAS_without_WHERE(String sql) {
	String sqlToScan = stripStringLiterals(sql);
	final Pattern ctasPattern = Pattern.compile("(create)(.+)(table)(.+)(as)(.+)(select)", Pattern.DOTALL | Pattern.CASE_INSENSITIVE);
	final Pattern wherePattern = Pattern.compile("(create)(.+)(table)(.+)(as)(.+)(select)(.+)(where)", Pattern.DOTALL | Pattern.CASE_INSENSITIVE);

	int n = sqlToScan.length();
	int stmtStart = 0;
	while (stmtStart <= n) {
		int semiIdx = sqlToScan.indexOf(";", stmtStart);
		int stmtEnd = (semiIdx == -1) ? n : semiIdx;
		if (stmtEnd > stmtStart) {
			String statement = sqlToScan.substring(stmtStart, stmtEnd);
			Matcher ctasMatcher = ctasPattern.matcher(statement);
			if (ctasMatcher.find()) {
				Matcher whereMatcher = wherePattern.matcher(statement);
				if (!whereMatcher.find()) {
					return true;
				}
			}
		}
		if (semiIdx == -1) {
			break;
		}
		stmtStart = stmtEnd + 1;
	}
	return false;
} 
rule "CTASmustHavePredicate"
    salience 1
	when
		ctas : WithoutComments(CTAS_found(getText()))
		ctas_where : WithoutComments(CTAS_without_WHERE(getText()))
	then
		reportCTASWithoutWhereLocations(ctas_where.getText(), ctas_where.getSqlFile().toString());
		String errorMessage = "CTAS statements should have a WHERE clause. (Script: " + ctas_where.getSqlFile().toString() + ")";
        insert(new Response(ResponseType.WARN, errorMessage, drools.getRule().getName()));
		
	end
