/*
@author Liquibase
@version 1.2
@date 13-Oct-2026
@description Error if SQL script does not contain a CTAS statement and there is an UPDATE or DELETE statement in the script.
*/

/*
README: 

This is a SQL Rule which throws ERROR when a sql script that has UPDATE or DELETE statements
does not contain "Create Table as Select".
To Execute this rule use:
hammer runRules [SQL file | SQL files folder]

Version 1.2:
- Strips quoted string literal contents (Oracle-style, dynamic-SQL aware)
  before scanning, so text values containing words like "update", "delete"
  or "create table ... as select" are not mistaken for SQL.
- Only counts an UPDATE or DELETE that is an actual statement: one that starts
  a statement, or follows BEGIN / LOOP / THEN / ELSE / EXCEPTION / DECLARE, or
  is the start of an EXECUTE IMMEDIATE string. Words that merely appear inside
  other statements no longer count, e.g. ON DELETE CASCADE, SELECT ... FOR
  UPDATE, BEFORE UPDATE OR DELETE in a trigger, GRANT UPDATE, DELETE.
- The CTAS check is now done one statement at a time, with whole-word matching,
  so "as" inside a name (e.g. last_names) plus a SELECT somewhere else in the
  file can no longer be mistaken for a CTAS.
- Prints a diagnostic (console + deployPackager log, so it also lands in
  daticaldb.log) for each UPDATE/DELETE statement, showing the starting text
  of the statement. Line numbers are NOT used because WithoutComments()
  strips comments before this text arrives, which would make line counts
  inaccurate.
- Behavior kept from the original: a CTAS anywhere in the file satisfies the
  rule for the whole file (it is not required to come before the UPDATE/DELETE).
*/

package com.datical.hammer.core.sqlrules.CTASrequiredOnlyUpdateDelete
import java.util.regex.Matcher;
import java.util.regex.Pattern;
import java.util.List;
import java.util.ArrayList;

import com.datical.db.project.Project;
import com.datical.hammer.core.rules.Response;
import com.datical.hammer.core.rules.Response.ResponseType;
import com.datical.hammer.core.rules.WithComments;
import com.datical.hammer.core.rules.WithoutComments;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

/***********************************************************  Rules  *************************************************************/

/*
 * Strips single-quoted SQL string literal contents so they are not scanned
 * as SQL. Handles Oracle-style doubled single quotes ('') as escaped quotes,
 * and is aware of EXECUTE IMMEDIATE dynamic SQL, where the real SQL command
 * is itself built as a string literal via concatenation.
 *
 * Known limitation: only triggers off the literal keyword "EXECUTE IMMEDIATE"
 * appearing before the string. Dynamic SQL built into a variable earlier and
 * executed later (v_sql := '...'; ... EXECUTE IMMEDIATE v_sql;) won't be
 * recognized as code, and the literal will be treated as an ordinary value
 * (fully masked). Also does not handle alternative Oracle quoting (q'[...]').
 */
function String stripStringLiterals(String sql) {
	StringBuilder out = new StringBuilder(sql.length());
	int n = sql.length();
	int i = 0;
	boolean inDynamicSqlChain = false;
	boolean dataMode = true;
	String upper = sql.toUpperCase();
	String KEYWORD = "EXECUTE IMMEDIATE";
	int keywordLen = KEYWORD.length();

	while (i < n) {
		String c = sql.substring(i, i + 1);

		if (c.equals("'")) {
			if (!inDynamicSqlChain) {
				dataMode = true;
			}
			out.append("'");
			i = i + 1;
			int valueStart = i;
			int outValueStart = out.length();
			boolean closed = false;
			while (i < n) {
				String lc = sql.substring(i, i + 1);
				if (lc.equals("'")) {
					if (i + 1 < n && sql.substring(i + 1, i + 2).equals("'")) {
						// outside EXECUTE IMMEDIATE a doubled quote is just an escaped quote
						if (inDynamicSqlChain) {
							dataMode = !dataMode;
						}
						out.append("''");
						i = i + 2;
						continue;
					} else {
						out.append("'");
						i = i + 1;
						closed = true;
						break;
					}
				} else {
					if (dataMode) {
						// preserve whitespace so masked data doesn't collapse into one
						// long non-whitespace run, which slows regex matching below
						if (lc.equals(" ") || lc.equals("\t") || lc.equals("\n") || lc.equals("\r")) {
							out.append(lc);
						} else {
							out.append("x");
						}
					} else {
						out.append(lc);
					}
					i = i + 1;
				}
			}
			if (!closed) {
				// never closed: not a value, keep the rest of the script as it is
				out.setLength(outValueStart);
				out.append(sql.substring(valueStart));
				i = n;
			}
			continue;
		}

		if (!inDynamicSqlChain && i + keywordLen <= n
				&& upper.regionMatches(i, KEYWORD, 0, keywordLen)) {
			inDynamicSqlChain = true;
			dataMode = false;
			out.append(sql.substring(i, i + keywordLen));
			i = i + keywordLen;
			continue;
		}

		if (inDynamicSqlChain && c.equals(";")) {
			inDynamicSqlChain = false;
		}

		out.append(c);
		i = i + 1;
	}

	return out.toString();
}

/*
 * Splits already-literal-stripped SQL into statements on top-level ';'
 * (safe after stripping, since masked data no longer contains stray
 * semicolons). Empty/whitespace-only chunks are skipped.
 */
function List<String> splitStatements(String sqlToScan) {
	List<String> result = new ArrayList<String>();
	int n = sqlToScan.length();
	int stmtStart = 0;
	while (stmtStart <= n) {
		int semiIdx = sqlToScan.indexOf(";", stmtStart);
		int stmtEnd = (semiIdx == -1) ? n : semiIdx;
		if (stmtEnd > stmtStart) {
			String statement = sqlToScan.substring(stmtStart, stmtEnd);
			if (statement.trim().length() > 0) {
				result.add(statement);
			}
		}
		if (semiIdx == -1) {
			break;
		}
		stmtStart = stmtEnd + 1;
	}
	return result;
}

/* CREATE ... TABLE ... AS ... SELECT within a single statement, whole words */
function Pattern ctasPattern() {
	return Pattern.compile("\\bcreate\\b.+\\btable\\b.+\\bas\\b.+\\bselect\\b", Pattern.DOTALL | Pattern.CASE_INSENSITIVE);
}

/*
 * An UPDATE or DELETE that is an actual statement: at the start of a
 * statement (a leading "/" from a PL/SQL terminator is allowed), right after
 * BEGIN / LOOP / THEN / ELSE / EXCEPTION / DECLARE, or at the start of an
 * EXECUTE IMMEDIATE string. This deliberately does NOT match UPDATE/DELETE
 * words inside other statements (ON DELETE CASCADE, FOR UPDATE, trigger
 * events, GRANT lists).
 */
function Pattern updateDeletePattern() {
	return Pattern.compile("(^[\\s/]*|\\b(begin|loop|then|else|exception|declare)\\s+|\\bimmediate\\s+'\\s*)(update|delete)\\s", Pattern.CASE_INSENSITIVE);
}

/*
 * Diagnostic only -- does not affect the FAIL/no-FAIL decision, which comes
 * from CTAS_required / update_delete below. Prints (to both console and the
 * deployPackager logger, so it also lands in daticaldb.log) the START OF THE
 * STATEMENT TEXT for each UPDATE/DELETE statement in the script. Since the
 * rule only fires when the script has no CTAS, every UPDATE/DELETE listed
 * here is one that has no CREATE TABLE ... AS SELECT backup in the script.
 */
function void reportUpdateDeleteStatements(String sql, String fileName) {
	String sqlToScan = stripStringLiterals(sql);
	final Pattern pattern = updateDeletePattern();
	int maxSnippetLen = 80;

	for (String statement : splitStatements(sqlToScan)) {
		if (pattern.matcher(statement).find()) {
			String snippet = statement.trim().replaceAll("\\s+", " ").replaceAll("^/\\s*", "");
			if (snippet.length() > maxSnippetLen) {
				snippet = snippet.substring(0, maxSnippetLen) + "...";
			}
			Logger log = LoggerFactory.getLogger("deployPackager");
			String diagnosticMessage = "CTASrequiredOnlyUpdateDelete: UPDATE/DELETE with no CTAS in script, statement starting with: \""
					+ snippet + "\" in file " + fileName;
			System.out.println(diagnosticMessage);
			log.info(diagnosticMessage);
		}
	}
}

/* @return true if CTAS is NOT found (checked one statement at a time) */

function boolean CTAS_required(String sql) {
    System.out.println("Validation called: CTASRequiredOnlyUpdateDelete"); 

	String sqlToScan = stripStringLiterals(sql);
	final Pattern pattern = ctasPattern();

	for (String statement : splitStatements(sqlToScan)) {
		if (pattern.matcher(statement).find()) {
/*			System.out.println("CTAS was found"); */
			return false;
		}
	}
/*	System.out.println("No CTAS was found"); */
	return true;
} 

/* @return true if an UPDATE or DELETE statement is found */
function boolean update_delete(String sql) {
/*    System.out.println("Validation called: Check for update or delete"); */

	String sqlToScan = stripStringLiterals(sql);
	final Pattern pattern = updateDeletePattern();

	for (String statement : splitStatements(sqlToScan)) {
		if (pattern.matcher(statement).find()) {
/*			System.out.println("UPDATE|DELETE was found"); */
			return true;
		}
	}
/*	System.out.println("No UPDATE|DELETE found"); */
	return false;
}

rule "CTASrequiredOnlyUpdateDelete"
    salience 1
	when
		ctas : WithoutComments(CTAS_required(getText()))
		up_del : WithoutComments(update_delete(getText()))
	then
		reportUpdateDeleteStatements(up_del.getText(), up_del.getSqlFile().toString());
		String errorMessage = "Must backup data using CREATE TABLE ... AS SELECT (Script: " + ctas.getSqlFile().toString() + ")";
        insert(new Response(ResponseType.FAIL, errorMessage, drools.getRule().getName()));
		
	end
